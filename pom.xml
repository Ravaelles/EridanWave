<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.dangant</groupId>
    <artifactId>EridanWave</artifactId>
    <version>1.0</version>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <scala.version>2.12.18</scala.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <project.resources.sourceEncoding>UTF-8</project.resources.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Scala dependencies -->
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala-library</artifactId>
            <version>${scala.version}</version>
        </dependency>
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala-reflect</artifactId>
            <version>${scala.version}</version>
        </dependency>

        <!-- Java dependencies -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.18.1</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>5.18.1</version>
        </dependency>
        <!-- JNativeHook: global keyboard shortcuts for local Wine/Windows dev games -->
        <dependency>
            <groupId>com.github.kwhat</groupId>
            <artifactId>jnativehook</artifactId>
            <version>2.2.2</version>
        </dependency>
        <!-- junixsocket: compile-only (provided) for vendored jbwapi's
             ClientConnectionPosix (OpenBW macOS/Linux transport). Never loaded
             at runtime: the bot runs on Windows/Wine, Client picks W32.
             Old no.fiken.oss 1.0.2 coordinates because the offline repo has them. -->
        <dependency>
            <groupId>no.fiken.oss.junixsocket</groupId>
            <artifactId>junixsocket-common</artifactId>
            <version>1.0.2</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>add-third-party-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>3rdparty/jbwapi/src/main/java</source>
                                <source>3rdparty/cherryvis/src/main/java</source>
                                <source>3rdparty/mjson/src/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
                <version>4.9.2</version>
                <executions>
                    <execution>
                        <id>compile-macros</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <sourceDir>${project.basedir}/src-macros</sourceDir>
                            <outputDir>${project.build.directory}/macro-classes</outputDir>
                            <analysisCacheFile>${project.build.directory}/analysis/macros</analysisCacheFile>
                            <sendJavaToScalac>false</sendJavaToScalac>
                            <includes>
                                <include>Utilities/TernaryMacros.scala</include>
                                <include>Utilities/Ternary.scala</include>
                                <include>Mathematics/Functions/ReduceMacros.scala</include>
                                <include>Mathematics/Functions/ReduceMacroForwarders.scala</include>
                            </includes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-main</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <analysisCacheFile>${project.build.directory}/analysis/main</analysisCacheFile>
                            <!-- Unit tests live under src/test and compile in the tests profile only. -->
                            <excludes>
                                <exclude>test/**</exclude>
                            </excludes>
                            <classpath>
                                <add>${project.build.directory}/${project.artifactId}-macros.jar</add>
                            </classpath>
                            <args>
                                <arg>-unchecked</arg>
                                <arg>-feature</arg>
                                <arg>-deprecation</arg> <!-- To disable deprecation warnings -->
                                <arg>-language:postfixOps</arg> <!-- To disable postfix operator warnings -->
                                <arg>-opt:unreachable-code</arg>
                                <arg>-opt:simplify-jumps</arg>
                                <arg>-opt:compact-locals</arg>
                                <arg>-opt:copy-propagation</arg>
                                <arg>-opt:redundant-casts</arg>
                                <arg>-opt:box-unbox</arg>
                                <arg>-opt:nullness-tracking</arg>
                                <arg>-opt:closure-invocations</arg>
                                <arg>-opt:inline</arg>
                                <arg>-opt:l:default,inline</arg>
                                <arg>-opt-inline-from:Micro.Targeting.**</arg>
                                <arg>-opt-inline-from:Information.Battles.Prediction.Simulation.Simulacrum</arg>
                                <arg>-Ymacro-classpath</arg>
                                <arg>${project.build.directory}/${project.artifactId}-macros.jar</arg>
                                <arg>-opt-warnings</arg>
                            </args>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <scalaVersion>${scala.version}</scalaVersion>
                    <recompileMode>incremental</recompileMode>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>package-macros</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <jar destfile="${project.build.directory}/${project.artifactId}-macros.jar"
                                     basedir="${project.build.directory}/macro-classes"
                                     update="true" />
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- Macro forwarders (e.g. ReduceMacroForwarders, object ?) live in
                             src-macros so main sources contain no macro definitions (which would
                             make zinc conservatively recompile half the codebase on any edit).
                             But they are inherited/called at RUNTIME, so their classfiles must
                             also be on the runtime classpath: copy them into target/classes
                             (before compile-main runs) so plain `mvn compile`, IDE runs and
                             the packaged jars all see them. -->
                        <id>include-macros-in-classes</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <unzip src="${project.build.directory}/${project.artifactId}-macros.jar"
                                       dest="${project.build.directory}/classes" />
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

           <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <forceCreation>true</forceCreation>
                    <archive>
                        <manifestFile>${project.basedir}/META-INF/MANIFEST.MF</manifestFile>
                    </archive>
                </configuration>
            </plugin>

            <!-- Maven Shade cerates a fat JAR with dependencies included -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.2.4</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>*:*</include>
                                </includes>
                            </artifactSet>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>Lifecycle.Main</mainClass>
                                </transformer>
                            </transformers>
                            <!-- Natives and classes for platforms we never run.
                                 Game runs on Wine win32-x86, Windows x86/x86-64
                                 and Docker linux-x86-64; foreign .dll/.so plus
                                 the multi-release duplicates (our runtimes use
                                 the base classes) are ~3 MB of dead weight. -->
                            <filters>
                                <filter>
                                    <artifact>net.java.dev.jna:jna</artifact>
                                    <excludes>
                                        <exclude>com/sun/jna/darwin*/**</exclude>
                                        <exclude>com/sun/jna/freebsd*/**</exclude>
                                        <exclude>com/sun/jna/linux-aarch64/**</exclude>
                                        <exclude>com/sun/jna/linux-arm*/**</exclude>
                                        <exclude>com/sun/jna/linux-mips*/**</exclude>
                                        <exclude>com/sun/jna/linux-ppc*/**</exclude>
                                        <exclude>com/sun/jna/linux-s390x/**</exclude>
                                        <exclude>com/sun/jna/linux-x86/**</exclude>
                                        <exclude>com/sun/jna/openbsd*/**</exclude>
                                        <exclude>com/sun/jna/sunos*/**</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>com.github.kwhat:jnativehook</artifact>
                                    <excludes>
                                        <exclude>META-INF/versions/**</exclude>
                                        <exclude>**/example/**</exclude>
                                        <exclude>com/github/kwhat/jnativehook/lib/darwin*/**</exclude>
                                        <exclude>com/github/kwhat/jnativehook/lib/linux/arm*/**</exclude>
                                        <exclude>com/github/kwhat/jnativehook/lib/linux/x86/**</exclude>
                                        <exclude>com/github/kwhat/jnativehook/lib/windows/arm/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <profiles>
        <!-- Unit tests (opt-in so offline dev builds never resolve test tooling):
             mvn -Ptests test. Suites live in src/test/scala, mirroring the
             src/ tree, one *Suite per unit (ScalaTest FunSuite).
             The legacy tests/ folder (standalone Apps run by scripts/test_*.ps1)
             is grandfathered and untouched by Maven. -->
        <profile>
            <id>tests</id>
            <dependencies>
                <dependency>
                    <groupId>org.scalatest</groupId>
                    <artifactId>scalatest_2.12</artifactId>
                    <version>3.2.17</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-core</artifactId>
                    <version>4.11.0</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>net.alchim31.maven</groupId>
                        <artifactId>scala-maven-plugin</artifactId>
                        <version>4.9.2</version>
                        <executions>
                            <execution>
                                <id>test-compile</id>
                                <phase>test-compile</phase>
                                <goals>
                                    <goal>testCompile</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.scalatest</groupId>
                        <artifactId>scalatest-maven-plugin</artifactId>
                        <version>2.2.0</version>
                        <configuration>
                            <!-- JUnit XML with per-test times for scripts/profile-tests.sh.
                                 Relative to the plugin reports dir, so this lands in
                                 target/scalatest-reports/junit-reports. -->
                            <junitxml>junit-reports</junitxml>
                        </configuration>
                        <executions>
                            <execution>
                                <id>test</id>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Fast dev loop (no optimizer passes): mvn -o -Pdev package.
             Release build (default profile) keeps all -opt flags for the shipped bot.
             NOTE: switching profiles changes compiler options, so the first build
             after a switch is a full recompile; subsequent ones are incremental. -->
        <profile>
            <id>dev</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>net.alchim31.maven</groupId>
                        <artifactId>scala-maven-plugin</artifactId>
                        <version>4.9.2</version>
                        <executions>
                            <execution>
                                <id>compile-main</id>
                                <configuration>
                                    <args combine.self="override">
                                        <arg>-unchecked</arg>
                                        <arg>-feature</arg>
                                        <arg>-deprecation</arg>
                                        <arg>-language:postfixOps</arg>
                                        <arg>-Ymacro-classpath</arg>
                                        <arg>${project.build.directory}/${project.artifactId}-macros.jar</arg>
                                    </args>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>idea-index-macros</id>
            <activation>
                <property>
                    <name>idea.maven.embedder.version</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <id>add-macro-sources-for-idea-indexing</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src-macros</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Windows EXE for the Combat Visualizer. Opt-in: mvn clean package -DbuildExe=true.
             On JDK 17 the old launch4j/XStream stack also needs MAVEN_OPTS with
             add-opens for java.base/java.util, java.base/java.lang,
             java.base/java.lang.reflect, java.base/java.text
             and java.desktop/java.awt.font (ALL-UNNAMED). -->
        <profile>
            <id>visualizer-exe</id>
            <activation>
                <property>
                    <name>buildExe</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>create-exe-output-dir</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${project.basedir}/out/artifacts" />
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Build a Windows EXE for the Combat Visualizer using Launch4j -->
                    <plugin>
                        <groupId>com.akathist.maven.plugins.launch4j</groupId>
                        <artifactId>launch4j-maven-plugin</artifactId>
                        <version>1.7.25</version>
                        <executions>
                            <execution>
                                <id>make-combat-visualizer-exe</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>launch4j</goal>
                                </goals>
                                <configuration>
                                    <!-- Use the shaded jar that includes all dependencies -->
                                    <outfile>${project.basedir}/out/artifacts/EridanSimViz.exe</outfile>
                                    <jar>${project.build.directory}/${project.artifactId}-${project.version}.jar</jar>
                                    <headerType>gui</headerType>
                                    <classPath>
                                        <!-- Override the entry point to the visualizer main class -->
                                        <mainClass>Debugging.EridanSimViz</mainClass>
                                    </classPath>
                                    <jre>
                                        <minVersion>1.8.0</minVersion>
                                        <jdkPreference>preferJre</jdkPreference>
                                        <runtimeBits>64/32</runtimeBits>
                                    </jre>
                                    <!-- Pass through the first argument (path to .pwcs/.pwsim) when double-clicked -->
                                    <cmdLine>%1</cmdLine>
                                    <versionInfo>
                                        <fileVersion>${project.version}.0.0</fileVersion>
                                        <txtFileVersion>${project.version}</txtFileVersion>
                                        <fileDescription>EridanSimViz</fileDescription>
                                        <productName>EridanSimViz</productName>
                                        <productVersion>${project.version}.0.0</productVersion>
                                        <txtProductVersion>${project.version}</txtProductVersion>
                                        <copyright>© EridanWave</copyright>
                                        <internalName>EridanSimViz</internalName>
                                        <originalFilename>EridanSimViz.exe</originalFilename>
                                    </versionInfo>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
